{
  "manifest_version": 3,
  "name": "הכול בשקלים",
  "version": "1.3.0",
  "homepage_url": "https://github.com/Uriel1010/shekel-converter",
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "description": "המרת מחירים לשקלים לצד המחיר המקורי לפי שערי מטבע יומיים.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://open.er-api.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "הכול בשקלים", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}},
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["money.js", "content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": true}]
}
